{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ara"
      ],
      "changelogUrl": "https://codeberg.org/ansible-community/ara/src/branch/master/doc/source/changelog-release-notes.rst"
    }
  ],
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "pin": {
    "automerge": true
  }
}
